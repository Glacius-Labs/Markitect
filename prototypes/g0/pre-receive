#!/usr/bin/env python3
"""Pre-receive hook of the Run remote: every push is decided by the referee."""
import json
import os
import sys
import urllib.request

updates = [line.split() for line in sys.stdin.read().splitlines() if line.strip()]
env = {k: v for k, v in os.environ.items()
       if k in ("GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_QUARANTINE_PATH")}
req = urllib.request.Request("http://127.0.0.1:8080/hook", method="POST",
                             data=json.dumps({"user": os.environ.get("REMOTE_USER", ""),
                                              "updates": updates, "env": env}).encode(),
                             headers={"Content-Type": "application/json"})
try:
    answer = json.load(urllib.request.urlopen(req, timeout=120))
except Exception as e:
    print(f"referee unavailable: {e}", file=sys.stderr)
    sys.exit(1)
if not answer.get("ok"):
    print(f"refused by the referee: {answer.get('reason')}", file=sys.stderr)
    sys.exit(1)
