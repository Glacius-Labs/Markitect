{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/path.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if [ -d \"${CLAUDE_PROJECT_DIR}/.markitect\" ]; then MARKITECT_ENSURE_ONLY=1 sh \"${CLAUDE_PLUGIN_ROOT}/bin/markitect\"; fi; true",
            "async": true
          }
        ]
      }
    ]
  }
}
