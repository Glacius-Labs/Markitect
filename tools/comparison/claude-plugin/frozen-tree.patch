+// Children returns the selected Manager's direct child Managers. Arm P adds it
+// to the frozen source for `markitect tree`; main has its own accessor.
+func (c ContextSelection) Children() []Manager {
+	manager, found := c.topology.Manager(c.packagePath)
+	if !found {
+		return nil
+	}
+	var children []Manager
+	for _, path := range manager.Children {
+		if child, found := c.topology.Manager(path); found {
+			children = append(children, child)
+		}
+	}
+	return children
+}
