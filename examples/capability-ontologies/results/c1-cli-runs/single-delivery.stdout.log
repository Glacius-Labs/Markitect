model:
    revision: 71e1ef73f3aeba139347cb30f070de12fa88631a
    digest: sha256:c8d2596bc3208d79ffe02ea4a2794337f86086b34d36a89d5278631f8080606f
    schemas:
        - apiVersion: delivery.example.org/v1
          purpose: Describes deployments, environments and rollout intent.
          kinds:
            Deployment:
                purpose: Selects a service deployment and its capacity.
                properties:
                    environment:
                        purpose: Selects the environment.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - development
                            - staging
                            - production
                    replicas:
                        purpose: Declares the requested instance count.
                        type: integer
                        minCount: 1
                        maxCount: 1
                    service:
                        purpose: Names the deployed service.
                        type: string
                        minCount: 1
                        maxCount: 1
            Rollout:
                purpose: Describes introduction of one deployment.
                properties:
                    approvalRequired:
                        purpose: Records whether an approval step is required.
                        type: boolean
                        minCount: 1
                        maxCount: 1
                    deployment:
                        purpose: Identifies the target deployment.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: delivery.example.org/v1
                            kind: Deployment
                    strategy:
                        purpose: Selects the rollout procedure.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - rolling
                            - blue-green
          source:
            path: module:c1-delivery@1.0.0/schema.yaml
            digest: sha256:b537b5acb5ed853928d4dfecbfd7286a5cdc2219e4c173dac61768cbb858f21b
            line: 1
    definitions:
        - apiVersion: delivery.example.org/v1
          kind: Deployment
          metadata:
            name: production
            namespace: payments
          purpose: Describes the production payments service.
          spec:
            environment: production
            replicas: 3
            service: payments-api
          source:
            path: examples/capability-ontologies/delivery/deployment.yaml
            digest: sha256:47e1a9044167b4f64a13af9f7121651245e1918a95799ffe41bf94a2615bf673
            line: 1
        - apiVersion: delivery.example.org/v1
          kind: Rollout
          metadata:
            name: production-rollout
            namespace: payments
          purpose: Describes the controlled production rollout.
          spec:
            approvalRequired: true
            deployment:
                apiVersion: delivery.example.org/v1
                kind: Deployment
                name: production
                namespace: payments
            strategy: rolling
          source:
            path: examples/capability-ontologies/delivery/rollout.yaml
            digest: sha256:219c5f260312bf6b5d746b223bc7b85cb077cb84ead4a423a4d489c415c0cf36
            line: 1
    edges:
        - from: '["delivery.example.org/v1","Rollout","payments","production-rollout"]'
          to: '["delivery.example.org/v1","Deployment","payments","production"]'
          property: deployment
