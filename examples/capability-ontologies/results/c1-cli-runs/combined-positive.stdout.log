model:
    revision: fe78ca35541ecd38ddc391b116d686686c40a039
    digest: sha256:b25f1e8f74858a867a8f9adddd1005e9f5d029a80b5a1e320adf316837978d59
    schemas:
        - apiVersion: architecture.example.org/v1
          purpose: Describes an application component map and dependencies.
          kinds:
            Component:
                purpose: Identifies one owned software unit and its layer.
                properties:
                    layer:
                        purpose: Places the component in a layer.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - presentation
                            - domain
                            - infrastructure
                    name:
                        purpose: Names the component.
                        type: string
                        minCount: 1
                        maxCount: 1
            Dependency:
                purpose: Records a directed dependency between components.
                properties:
                    rationale:
                        purpose: States the dependency reason.
                        type: string
                        minCount: 1
                        maxCount: 1
                    source:
                        purpose: Identifies the dependent component.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: architecture.example.org/v1
                            kind: Component
                    target:
                        purpose: Identifies the dependency target.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: architecture.example.org/v1
                            kind: Component
          source:
            path: module:c1-software-architecture@1.0.0/schema.yaml
            digest: sha256:eb448a92db6b3ece7ff93aacbf907c5c73d5d8f1d9aa025f922c035ca81f90a1
            line: 1
        - apiVersion: cardgame.example.org/v1
          purpose: Describes cards and combat actions in a turn-based duel.
          kinds:
            Card:
                purpose: Defines a playable card and printed combat values.
                properties:
                    cost:
                        purpose: States the resource cost.
                        type: integer
                        minCount: 1
                        maxCount: 1
                    name:
                        purpose: Names the card.
                        type: string
                        minCount: 1
                        maxCount: 1
                    power:
                        purpose: States the combat power.
                        type: integer
                        minCount: 1
                        maxCount: 1
            CombatAction:
                purpose: Records a card's action for one turn.
                properties:
                    action:
                        purpose: Selects the combat action.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - attack
                            - block
                            - support
                    card:
                        purpose: Identifies the acting card.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: cardgame.example.org/v1
                            kind: Card
                    targets:
                        purpose: Lists opposing targets.
                        type: string
                        minCount: 0
                        maxCount: -1
          source:
            path: module:c1-trading-card-combat@1.0.0/schema.yaml
            digest: sha256:5f54445aab595fd08422597a3a6ffde93dbf2c79697693e4b8055a1ae2166ef1
            line: 1
        - apiVersion: delivery.example.org/v1
          purpose: Describes deployments, environments and rollout intent.
          kinds:
            Deployment:
                purpose: Selects a service deployment and its capacity.
                properties:
                    environment:
                        purpose: Selects the environment.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - development
                            - staging
                            - production
                    replicas:
                        purpose: Declares the requested instance count.
                        type: integer
                        minCount: 1
                        maxCount: 1
                    service:
                        purpose: Names the deployed service.
                        type: string
                        minCount: 1
                        maxCount: 1
            Rollout:
                purpose: Describes introduction of one deployment.
                properties:
                    approvalRequired:
                        purpose: Records whether an approval step is required.
                        type: boolean
                        minCount: 1
                        maxCount: 1
                    deployment:
                        purpose: Identifies the target deployment.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: delivery.example.org/v1
                            kind: Deployment
                    strategy:
                        purpose: Selects the rollout procedure.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - rolling
                            - blue-green
          source:
            path: module:c1-delivery@1.0.0/schema.yaml
            digest: sha256:b537b5acb5ed853928d4dfecbfd7286a5cdc2219e4c173dac61768cbb858f21b
            line: 1
        - apiVersion: filing.example.org/v1
          purpose: Tracks a submitted filing and its human review outcome.
          kinds:
            Filing:
                purpose: Records the state of a submitted dossier.
                properties:
                    status:
                        purpose: Records the filing lifecycle state.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - draft
                            - submitted
                            - returned
                            - accepted
                    title:
                        purpose: Names the submitted filing.
                        type: string
                        minCount: 1
                        maxCount: 1
            Review:
                purpose: Records one review disposition and explanation.
                properties:
                    filing:
                        purpose: Identifies the filing under review.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: filing.example.org/v1
                            kind: Filing
                    filingKind:
                        purpose: Identifies the reviewed subject's nominal Kind.
                        type: kindReference
                        minCount: 1
                        maxCount: 1
                    outcome:
                        purpose: Records the review disposition.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - comment
                            - return
                            - accept
                    reasons:
                        purpose: Lists concise findings.
                        type: string
                        minCount: 0
                        maxCount: -1
                    reviewer:
                        purpose: Names the reviewer.
                        type: string
                        minCount: 1
                        maxCount: 1
          source:
            path: module:c1-filing-review@1.0.0/schema.yaml
            digest: sha256:d1718b05e222ed49494abc5b5da6d5360202b9b8cf747c5d14527cd58e194c37
            line: 1
        - apiVersion: responsibility.example.org/v1
          purpose: Records work ownership and workflow decision authority.
          kinds:
            Role:
                purpose: Names a workflow role and its authority.
                properties:
                    authority:
                        purpose: States the role's authority.
                        type: enum
                        minCount: 1
                        maxCount: 1
                        values:
                            - owner
                            - approver
                            - operator
                    name:
                        purpose: Gives the role a readable name.
                        type: string
                        minCount: 1
                        maxCount: 1
            WorkItem:
                purpose: Assigns accountability and review participation.
                properties:
                    accountable:
                        purpose: Identifies the accountable role.
                        type: reference
                        minCount: 1
                        maxCount: 1
                        target:
                            apiVersion: responsibility.example.org/v1
                            kind: Role
                    reviewers:
                        purpose: Lists review roles.
                        type: reference
                        minCount: 0
                        maxCount: -1
                        target:
                            apiVersion: responsibility.example.org/v1
                            kind: Role
                    title:
                        purpose: Names the work.
                        type: string
                        minCount: 1
                        maxCount: 1
          source:
            path: module:c1-workflow-responsibility@1.0.0/schema.yaml
            digest: sha256:c91a5836f3d29e3fe530d3f104750033966d27d9aa7c860aae0c82ec02e3fbc4
            line: 1
    definitions:
        - apiVersion: architecture.example.org/v1
          kind: Component
          metadata:
            name: catalog
            namespace: shop
          purpose: Publishes product catalog behavior.
          spec:
            layer: domain
            name: Catalog
          source:
            path: examples/capability-ontologies/software-architecture/components.yaml
            digest: sha256:be1acde21de51f7091540623a1ed81e1bd5f56ecb769abf436e7fc71ffdbe700
            line: 1
        - apiVersion: architecture.example.org/v1
          kind: Component
          metadata:
            name: catalog-db
            namespace: shop
          purpose: Stores catalog records.
          spec:
            layer: infrastructure
            name: Catalog database
          source:
            path: examples/capability-ontologies/software-architecture/storage.yaml
            digest: sha256:5dbc7eb6b75ab58dfd3ae1f2aa507b42ab37327f3bd8d8a228f7e08f86d7932a
            line: 1
        - apiVersion: architecture.example.org/v1
          kind: Dependency
          metadata:
            name: catalog-storage
            namespace: shop
          purpose: Declares the catalog storage dependency.
          spec:
            rationale: Catalog reads records from the selected store.
            source:
                apiVersion: architecture.example.org/v1
                kind: Component
                name: catalog
                namespace: shop
            target:
                apiVersion: architecture.example.org/v1
                kind: Component
                name: catalog-db
                namespace: shop
          source:
            path: examples/capability-ontologies/software-architecture/dependency.yaml
            digest: sha256:74a915efe105d8701c97af1cf2415669627fecdb0b8a0e3af633f7d54d972135
            line: 1
        - apiVersion: cardgame.example.org/v1
          kind: Card
          metadata:
            name: ember-fox
            namespace: starter-deck
          purpose: Defines a low-cost creature that can attack.
          spec:
            cost: 1
            name: Ember Fox
            power: 2
          source:
            path: examples/capability-ontologies/trading-card-combat/card.yaml
            digest: sha256:a98b1445a4324cf7c71d80fbe1564c49cb9a7dc4ad98c50eecde084e6c100f70
            line: 1
        - apiVersion: cardgame.example.org/v1
          kind: CombatAction
          metadata:
            name: fox-attack
            namespace: match-7
          purpose: Declares Ember Fox attacking the opposing sentinel.
          spec:
            action: attack
            card:
                apiVersion: cardgame.example.org/v1
                kind: Card
                name: ember-fox
                namespace: starter-deck
            targets:
                - sentinel
          source:
            path: examples/capability-ontologies/trading-card-combat/action.yaml
            digest: sha256:e97dfb8a09bb99dea44a63ac9438136453a0b8f9c4cb28b6f5020ace65810cfd
            line: 1
        - apiVersion: delivery.example.org/v1
          kind: Deployment
          metadata:
            name: production
            namespace: payments
          purpose: Describes the production payments service.
          spec:
            environment: production
            replicas: 3
            service: payments-api
          source:
            path: examples/capability-ontologies/delivery/deployment.yaml
            digest: sha256:47e1a9044167b4f64a13af9f7121651245e1918a95799ffe41bf94a2615bf673
            line: 1
        - apiVersion: delivery.example.org/v1
          kind: Rollout
          metadata:
            name: production-rollout
            namespace: payments
          purpose: Describes the controlled production rollout.
          spec:
            approvalRequired: true
            deployment:
                apiVersion: delivery.example.org/v1
                kind: Deployment
                name: production
                namespace: payments
            strategy: rolling
          source:
            path: examples/capability-ontologies/delivery/rollout.yaml
            digest: sha256:219c5f260312bf6b5d746b223bc7b85cb077cb84ead4a423a4d489c415c0cf36
            line: 1
        - apiVersion: filing.example.org/v1
          kind: Filing
          metadata:
            name: dossier-17
            namespace: vendor-a
          purpose: Records the dossier submitted by vendor A.
          spec:
            status: submitted
            title: Data processing dossier
          source:
            path: examples/capability-ontologies/filing-review/filing.yaml
            digest: sha256:89468027afbb651a02365c9b4668aca4e9a798d6118d03534889419bdafa2885
            line: 1
        - apiVersion: filing.example.org/v1
          kind: Review
          metadata:
            name: initial-review
            namespace: vendor-a
          purpose: Captures reviewer feedback on dossier 17.
          spec:
            filing:
                apiVersion: filing.example.org/v1
                kind: Filing
                name: dossier-17
                namespace: vendor-a
            filingKind:
                apiVersion: filing.example.org/v1
                kind: Filing
            outcome: comment
            reasons:
                - Clarify the retention period
            reviewer: reviewer-42
          source:
            path: examples/capability-ontologies/filing-review/review.yaml
            digest: sha256:895ea9d63e748cee22fd52044a982570bf75f633cd7d202f854b3fb04acf22c4
            line: 1
        - apiVersion: responsibility.example.org/v1
          kind: Role
          metadata:
            name: approver
            namespace: release
          purpose: Reviews the release task before completion.
          spec:
            authority: approver
            name: Release approver
          source:
            path: examples/capability-ontologies/workflow-responsibility/approver.yaml
            digest: sha256:6e57bae088579fcce9dd3ef2c76d5e4e26692e52b39af79c1dda5e6188f786b9
            line: 1
        - apiVersion: responsibility.example.org/v1
          kind: Role
          metadata:
            name: owner
            namespace: release
          purpose: Owns completion of the release task.
          spec:
            authority: owner
            name: Release owner
          source:
            path: examples/capability-ontologies/workflow-responsibility/owner.yaml
            digest: sha256:2327201a33d4e16243913a27dc95ca6710b0ce10890d5d9b3608440f3b0eb2c3
            line: 1
        - apiVersion: responsibility.example.org/v1
          kind: WorkItem
          metadata:
            name: publish-candidate
            namespace: release
          purpose: Assigns ownership and review for publishing a candidate.
          spec:
            accountable:
                apiVersion: responsibility.example.org/v1
                kind: Role
                name: owner
                namespace: release
            reviewers:
                - apiVersion: responsibility.example.org/v1
                  kind: Role
                  name: approver
                  namespace: release
            title: Publish the candidate
          source:
            path: examples/capability-ontologies/workflow-responsibility/work-item.yaml
            digest: sha256:0c865c67db7b8c6038e2508e8f3106e125be5afbeec2a12535c7777594948f99
            line: 1
