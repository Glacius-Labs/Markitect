apiVersion: markitect.example.org/projections/v1alpha1
version: "1"
contracts:
  - id: dispatch-human-and-provider-views
    sources:
      - /Project/projection-first-dispatch
      - dispatch/Rule/dispatch-process
      - dispatch/Skill/list-open-listings
      - dispatch/dispatch.example.org/v1alpha1/DispatchBoard/north
      - dispatch/dispatch.example.org/v1alpha1/DispatchProcess/python-materialization
      - dispatch/dispatch.example.org/v1alpha1/Listing/renewal-a
      - dispatch/dispatch.example.org/v1alpha1/Listing/renewal-b
      - dispatch/dispatch.example.org/v1alpha1/Listing/renewal-c
      - dispatch/dispatch.example.org/v1alpha1/ListingView/list-open-listings
      - dispatch/dispatch.example.org/v1alpha1/Owner/dispatch-team
      - domain:dispatch.example.org/v1alpha1/dispatch
    representation: Human Markdown and registered Codex/Claude Rule and Skill views.
    materializer:
      name: markitect-render
      version: v1alpha1
      mode: deterministic
    targets:
      - path: .agents/skills/list-open-listings/SKILL.md
      - path: .claude/rules/dispatch-process.md
      - path: .claude/skills/list-open-listings/SKILL.md
      - path: docs/markitect/README.md
      - path: docs/markitect/_domains/README.md
      - path: docs/markitect/_domains/dispatch.example.org.v1alpha1.domain.md
      - path: docs/markitect/dispatch/README.md
      - path: docs/markitect/dispatch/board.dispatchboard.dispatch.example.org.v1alpha1.md
      - path: docs/markitect/dispatch/dispatch-process.rule.md
      - path: docs/markitect/dispatch/list-open-listings.listingview.dispatch.example.org.v1alpha1.md
      - path: docs/markitect/dispatch/list-open-listings.skill.md
      - path: docs/markitect/dispatch/owner.owner.dispatch.example.org.v1alpha1.md
      - path: docs/markitect/dispatch/process.dispatchprocess.dispatch.example.org.v1alpha1.md
      - path: docs/markitect/dispatch/renewal-a.listing.dispatch.example.org.v1alpha1.md
      - path: docs/markitect/dispatch/renewal-b.listing.dispatch.example.org.v1alpha1.md
      - path: docs/markitect/dispatch/renewal-c.listing.dispatch.example.org.v1alpha1.md
    verificationChecks: []
    freedom:
      - Registered renderers determine bytes from canonical resources and selected targets.
    dependsOn: []
  - id: dispatch-python-materialization
    sources:
      - dispatch/dispatch.example.org/v1alpha1/ListingView/list-open-listings
      - dispatch/dispatch.example.org/v1alpha1/DispatchProcess/python-materialization
      - dispatch/Rule/dispatch-process
      - dispatch/Skill/list-open-listings
    representation: Python standard-library JSON-in/JSON-out listing command plus tests, CI, and pre-commit integration.
    materializer:
      name: coding-agent
      version: illustrative-v1
      mode: ai
    targets:
      - path: scripts/list_open_listings.py
      - path: tests/test_list_open_listings.py
      - path: .github/workflows/ci.yaml
      - path: .githooks/pre-commit
    verificationChecks:
      - python-tests
      - independent-contract
    freedom:
      - Choose internal decomposition while retaining the exact filter, sorting, row-preservation, and stdout behavior.
      - Use only the Python standard library and no network access.
      - Keep project files unchanged while handling input and producing output.
    dependsOn:
      - dispatch-human-and-provider-views
