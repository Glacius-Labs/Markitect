<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(AdopterRoot)\src\Modules\Meetings\Application\CompanyName.MyMeetings.Modules.Meetings.Application.csproj" />
    <Compile Include="$(AdopterRoot)\src\Modules\Meetings\Tests\ArchTests\Application\ApplicationTests.cs" Link="Upstream\ApplicationTests.cs" />
  </ItemGroup>

  <Target Name="RequireAdopterRoot" BeforeTargets="PrepareForBuild" Condition="'$(AdopterRoot)' == ''">
    <Error Text="Set AdopterRoot to the selected trial checkout before building the evaluation runner." />
  </Target>
</Project>
