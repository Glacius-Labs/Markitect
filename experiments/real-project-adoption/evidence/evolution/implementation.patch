diff --git a/src/Modules/Meetings/Application/Meetings/AddMeetingAttendee/AddMeetingAttendeeCommandValidator.cs b/src/Modules/Meetings/Application/Meetings/AddMeetingAttendee/AddMeetingAttendeeCommandValidator.cs
new file mode 100644
index 0000000..165155f
--- /dev/null
+++ b/src/Modules/Meetings/Application/Meetings/AddMeetingAttendee/AddMeetingAttendeeCommandValidator.cs
@@ -0,0 +1,13 @@
+using FluentValidation;
+
+namespace CompanyName.MyMeetings.Modules.Meetings.Application.Meetings.AddMeetingAttendee
+{
+    internal class AddMeetingAttendeeCommandValidator : AbstractValidator<AddMeetingAttendeeCommand>
+    {
+        public AddMeetingAttendeeCommandValidator()
+        {
+            this.RuleFor(c => c.MeetingId).NotEmpty()
+                .WithMessage("Meeting id cannot be empty.");
+        }
+    }
+}
