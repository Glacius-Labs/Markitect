@@ -0,0 +1,13 @@
+using FluentValidation;
+
+namespace CompanyName.MyMeetings.Modules.Meetings.Application.Meetings.CancelMeeting
+{
+    internal class CancelMeetingCommandValidator : AbstractValidator<CancelMeetingCommand>
+    {
+        public CancelMeetingCommandValidator()
+        {
+            this.RuleFor(c => c.MeetingId).NotEmpty()
+                .WithMessage("Meeting id cannot be empty.");
+        }
+    }
+}
