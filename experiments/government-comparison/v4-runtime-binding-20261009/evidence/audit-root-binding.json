    {
      "path": "internal/host/agentexec/json.go",
      "firstLine": 199,
      "lastLine": 220,
      "sourceWorkingSha256": "b6f7ee75a8bf007d0f1facfafc5b6a9ee72aaae270e641170aab53815d861104",
      "lines": [
        "func canonicalObject(raw json.RawMessage, label string, max int) (json.RawMessage, error) {",
        "\tif len(raw) == 0 || len(raw) > max {",
        "\t\treturn nil, fmt.Errorf(\"%s is empty or exceeds its size bound\", label)",
        "\t}",
        "\tif err := rejectDuplicateKeys(raw); err != nil {",
        "\t\treturn nil, fmt.Errorf(\"%s: %w\", label, err)",
        "\t}",
        "\tvar value any",
        "\tdecoder := json.NewDecoder(bytes.NewReader(raw))",
        "\tdecoder.UseNumber()",
        "\tif err := decoder.Decode(&value); err != nil {",
        "\t\treturn nil, fmt.Errorf(\"%s is invalid JSON: %w\", label, err)",
        "\t}",
        "\tobject, ok := value.(map[string]any)",
        "\tif !ok || object == nil {",
        "\t\treturn nil, fmt.Errorf(\"%s must be a JSON object\", label)",
        "\t}",
        "\tcanonical, err := json.Marshal(object)",
        "\tif err != nil {",
        "\t\treturn nil, fmt.Errorf(\"%s cannot be encoded: %w\", label, err)",
        "\t}",
        "\treturn canonical, nil"
      ]
    },
