      "lines": [
        "func run(parent context.Context, cfg Config, request Request, opts RunOptions) (RunResult, error) {",
        "\tif parent == nil {",
        "\t\treturn RunResult{}, errors.New(\"execution context is required\")",
        "\t}",
        "\treq, requestJSON, err := normalizeRequest(request)",
        "\tif err != nil {",
        "\t\treturn RunResult{}, err",
        "\t}",
        "\troots, err := normalizeRoots(opts.InputRoots)",
        "\tif err != nil {",
        "\t\treturn RunResult{}, err",
        "\t}",
        "\ttempParent := opts.TempParent",
        "\tif tempParent == \"\" {",
        "\t\ttempParent = os.TempDir()",
        "\t}",
        "\ttempParent, err = canonicalDir(tempParent)",
        "\tif err != nil {",
        "\t\treturn RunResult{}, fmt.Errorf(\"temporary parent: %w\", err)",
        "\t}",
        "\tif pathWithinAny(tempParent, roots) {",
        "\t\treturn RunResult{}, errors.New(\"temporary parent is within an audited input root\")",
        "\t}",
        "\tprivateLogDir, err := preparePrivateLogDirectory(opts.PrivateLogDirectory, roots)",
        "\tif err != nil {",
        "\t\treturn RunResult{}, err",
        "\t}",
        "",
        "\tcfg, executable, runtimeBefore, runtimeDigest, executableDigest, configDigest, err := fingerprintConfig(cfg)",
        "\tif err != nil {",
        "\t\treturn RunResult{}, err",
        "\t}"
      ]
    },
