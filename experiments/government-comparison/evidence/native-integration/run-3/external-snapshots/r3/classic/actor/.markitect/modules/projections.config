apiVersion: markitect.example.org/projections/v1alpha1
version: '1'
contracts:
- id: markitect-engineering-guidance
  sources:
  - /Project/markitect-development
  - core/Rule/canonical-ownership
  - core/Skill/authoring
  - core/Text/resource-modelling
  - core/Workflow/authoring-change
  - core/Workflow/constitution-change
  - core/Workflow/engineering-discovery
  - core/Workflow/markitect-first-change
  - development/Rule/module-verification
  - development/Rule/repository-boundaries
  - development/Skill/engineering-change
  representation: human-and-provider-engineering-guidance
  materializer:
    name: markitect-render
    version: v1alpha1
    mode: deterministic
  targets:
  - path: .agents/skills/authoring/SKILL.md
  - path: .agents/skills/engineering-change/SKILL.md
  - path: .claude/skills/authoring/SKILL.md
  - path: .claude/skills/engineering-change/SKILL.md
  - path: docs/markitect/README.md
  - path: docs/markitect/core/README.md
  - path: docs/markitect/core/rule-canonical-ownership.rule.md
  - path: docs/markitect/core/skill-authoring.skill.md
  - path: docs/markitect/core/text-resource-modelling.text.md
  - path: docs/markitect/core/workflow-authoring-change.workflow.md
  - path: docs/markitect/core/workflow-constitution-change.workflow.md
  - path: docs/markitect/core/workflow-engineering-discovery.workflow.md
  - path: docs/markitect/core/workflow-markitect-first-change.workflow.md
  - path: docs/markitect/development/README.md
  - path: docs/markitect/development/engineering-change.skill.md
  - path: docs/markitect/development/module-verification.rule.md
  - path: docs/markitect/development/repository-boundaries.rule.md
