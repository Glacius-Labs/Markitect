              spec:
                artifact:
                    apiVersion: markitect.government/v1alpha1
                    kind: Artifact
                    name: release-source
                    namespace: inventory
                role: Adds released stock with explicit integer-overflow protection.
                subject:
                    apiVersion: markitect.government-example/v1alpha1
                    kind: Requirement
                    name: safe-release
                    namespace: inventory
              source:
                path: government.yaml
                digest: sha256:816041553684dc5710baf63217d435f62e9f997d1bbba4b74d9a2c4803da4325
            - apiVersion: markitect.government/v1alpha1
              kind: Realization
              metadata:
                name: release-test-realization
                namespace: inventory
              purpose: The focused test verifies the Requirement boundary and ordinary addition.
              spec:
                artifact:
                    apiVersion: markitect.government/v1alpha1
                    kind: Artifact
                    name: release-test
                    namespace: inventory
                role: Checks overflow rejection and in-range addition.
                subject:
                    apiVersion: markitect.government-example/v1alpha1
                    kind: Requirement
                    name: safe-release
                    namespace: inventory
              source:
                path: government.yaml
                digest: sha256:816041553684dc5710baf63217d435f62e9f997d1bbba4b74d9a2c4803da4325
            - apiVersion: markitect.government/v1alpha1
              kind: Responsibility
              metadata:
                name: release-owner
                namespace: inventory
              purpose: The root Area is accountable for the one inventory Requirement.
              spec:
                area:
                    apiVersion: markitect.government/v1alpha1
                    kind: Area
                    name: root
                    namespace: inventory
                subject:
                    apiVersion: markitect.government-example/v1alpha1
