  "notificationDisposition": {
    "thread/started": "correlate the thread ID and full reported permission/model/cwd evidence before any turn; notification may precede thread/start response",
    "thread/status/changed": "record exact threadId/status; only expected active-to-idle lifecycle for this thread; status is not independent permission proof",
    "thread/closed": "accept only after a positively completed correlated turn; otherwise stop",
    "turn/started": "bind one turnId to the owned thread; status must be inProgress",
    "turn/completed": "terminal proof only when same thread/turn IDs, status completed and no error; interrupted/failed is terminal stop",
    "item/started": "track bounded expected itemId/type under same threadId/turnId; only fixed input echo, reasoning, agentMessage and one commandExecution item",
    "item/completed": "match itemId/type and same threadId/turnId; commandExecution must have exact frozen command/cwd, status completed and exitCode 0",
    "item/agentMessage/delta": "accumulate only bounded agentMessage output tied to a tracked item; do not treat a delta as final answer",
    "item/commandExecution/outputDelta": "bounded tool stdout delta tied to the one tracked commandExecution item; compare final output to external expected value",
    "item/reasoning/summaryTextDelta": "validate and discard all text; do not persist or expose it",
    "item/reasoning/summaryPartAdded": "validate and record only item/summary indices if needed; do not persist reasoning content",
    "item/reasoning/textDelta": "validate and discard all text; do not persist or expose it",
    "thread/tokenUsage/updated": "record latest same-thread/turn cumulative usage; do not sum repeated cumulative values"
  },
  "recognizedItemTypes": {
    "userMessage": {
      "member": "ServerNotification.json#/definitions/ThreadItem",
      "required": [
        "content",
        "id",
        "type"
      ],
      "boundedFields": [
        "id",
        "type",
        "content"
      ],
      "handling": "input echo only; compare against fixed prompt if surfaced; do not count as a task tool or persist arbitrary text"
    },
    "reasoning": {
      "member": "ServerNotification.json#/definitions/ThreadItem",
      "required": [
        "id",
        "type"
      ],
      "boundedFields": [
        "id",
        "type"
      ],
      "handling": "discard reasoning content and summary text"
    },
    "agentMessage": {
      "member": "ServerNotification.json#/definitions/ThreadItem",
      "required": [
        "id",
        "text",
        "type"
      ],
      "boundedFields": [
        "id",
        "type",
        "text"
      ],
      "handling": "bounded final-answer candidate; require completed item and completed turn before judging against fixed expected shape"
    },
    "commandExecution": {
      "member": "ServerNotification.json#/definitions/ThreadItem",
      "required": [
        "command",
        "commandActions",
        "cwd",
        "id",
        "status",
        "type"
      ],
      "boundedFields": [
        "id",
        "type",
        "command",
        "commandActions",
        "cwd",
        "status",
        "exitCode",
        "aggregatedOutput",
        "source"
      ],
      "handling": "at most one; exact frozen command and actor cwd; status completed and exitCode 0; action list is best-effort classification, command text and correlated result are primary"
    }
  },
  "correlation": {
    "threadId": "thread/start response thread.id; thread/started thread.id must agree; all later threadId values must equal it",
    "turnId": "turn/start response turn.id and turn/started turn.id must agree; all turnId values must equal it",
    "itemId": "item.started/item.completed item.id; output-delta itemId must match the sole commandExecution item",
    "rpc": "JSON-RPC request id correlates each method response only; notification identity is carried in payload IDs and must be bound to the RPC-returned IDs",
    "terminal": "turn/completed with same threadId and turn.id is required; success additionally requires completed status, no error, completed command item with exitCode 0, observed output equals external expected content, and final completed agentMessage matches the fixed allowed public shape"
  },
  "ordering": {
    "schemaGuarantee": "The pinned JSON Schemas define payload shape and required fields, not notification ordering or causality.",
    "preResponse": "thread/started or turn/started and subsequent item/output events can be observed before the corresponding start response in a multiplexed RPC stream; retain only bounded, schema-valid events and bind them after the response IDs arrive. An ID mismatch, excess buffer, or event inconsistent with the final IDs stops.",
    "itemDeltas": "Output and agent-message deltas may precede item/completed; item completion is required for final item status. Do not infer finality from a delta.",
    "terminalOrder": "After turn/completed, no later event may reopen or add an item to the completed turn; thread/closed is tolerated only as post-completion closure. The schema itself does not assert this ordering."
  },
  "stopPolicy": {
    "default": "Stop on every top-level server notification method not listed in notifications, every server request, JSON-RPC error, malformed or unknown frame, identity/schema mismatch, warning/provisional/permission/auth/model-reroute event, or forbidden/second task tool item.",
    "explicitMethods": [
