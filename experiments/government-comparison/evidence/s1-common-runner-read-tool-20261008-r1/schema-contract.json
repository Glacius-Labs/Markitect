      "configWarning",
      "guardianWarning",
      "model/rerouted",
      "model/verification",
      "modelProvider/authRecoveryStarted",
      "modelProvider/authRecoveryCompleted",
      "serverRequest/resolved",
      "thread/settings/updated",
      "account/updated",
      "account/gatewayOAuth/changed"
    ],
    "noClientApprovalReplies": true
  },
  "sourceLimit": "This packet freezes protocol shapes/method names from the pinned archive only. It does not assert OS permission enforcement, provider request count, model identity beyond reported fields, or sequence guarantees absent from schema."
