{"apiVersion":"markitect.example.org/agent-execution/v1alpha1","candidateFiles":[{"content":"package inventory\n\nimport (\n\t\"errors\"\n\t\"math\"\n)\n\nvar ErrOverflow = errors.New(\"available stock would overflow\")\n\n// Release adds released stock to available inventory without wrapping.\nfunc Release(available, amount int64) (int64, error) {\n\tif amount < 0 {\n\t\treturn available, errors.New(\"release amount cannot be negative\")\n\t}\n\tif amount > 0 && available > math.MaxInt64-amount {\n\t\treturn available, ErrOverflow\n\t}\n\treturn available + amount, nil\n}\n","mode":"0644","path":"inventory/reservation.go"},{"content":"package inventory\n\nimport (\n\t\"errors\"\n\t\"math\"\n\t\"testing\"\n)\n\nfunc TestReleaseRejectsOverflow(t *testing.T) {\n\tif _, err := Release(math.MaxInt64, 1); !errors.Is(err, ErrOverflow) {\n\t\tt.Fatalf(\"Release(MaxInt64, 1) error = %v, want ErrOverflow\", err)\n\t}\n}\n\nfunc TestReleaseAddsWithinRange(t *testing.T) {\n\tgot, err := Release(8, 3)\n\tif err != nil || got != 11 {\n\t\tt.Fatalf(\"Release(8, 3) = (%d, %v), want (11, nil)\", got, err)\n\t}\n}\n","mode":"0644","path":"inventory/reservation_test.go"}],"evidenceRefs":["[\"markitect.government-example/v1alpha1\",\"Requirement\",\"inventory\",\"safe-release\"]","[\"markitect.government/v1alpha1\",\"Constitution\",\"inventory\",\"active\"]","inventory/reservation.go","inventory/reservation_test.go"],"inputDigest":"sha256:9aa114e262ace980f226a942d67359a5f25092a85b2589696c9da4e2c087f454","nonce":"4634e06012919fbe4a287fd0614bc54e","outcome":"proposed","role":"executor","runId":"4f8e158108253307ce8d926e3d0214ab","uncertainty":[],"verifierObservations":[]}
