designVersion: project-world/0.1
resources:
  - kind: Concept
    id: sales/order
    owner: orders-manager
    area: orders
    purpose: Den angenommenen Kaufauftrag mit Positionen und Lebenszyklus beschreiben.
    module: sales-domain
    namespace: sales
    meaning: Eine Order hat eine stabile Identität und Positionen mit Artikel und Menge.
    uses: [sales/confirmed, sales/shipped, sales/cancelled]
  - {kind: State, id: sales/confirmed, owner: orders-manager, area: orders, purpose: Angenommene und noch nicht versandte Bestellungen unterscheiden., module: sales-domain, namespace: sales, meaning: Die Order ist angenommen und noch nicht an den Versand übergeben.}
  - {kind: State, id: sales/shipped, owner: orders-manager, area: orders, purpose: Den Versand als Grenze der Stornierbarkeit benennen., module: sales-domain, namespace: sales, meaning: Die Order wurde an den Versand übergeben.}
  - {kind: State, id: sales/cancelled, owner: orders-manager, area: orders, purpose: Die aufgehobene Bestellabsicht festhalten., module: sales-domain, namespace: sales, meaning: Die Order wird nicht mehr ausgeführt.}
  - kind: Concept
    id: sales/cancellation
    owner: orders-manager
    area: orders
    purpose: Stornierung als eindeutigen Zustandswechsel beschreiben.
    module: sales-domain
    namespace: sales
    meaning: Eine bestätigte Order wechselt in den Zustand storniert.
    uses: [sales/order, sales/confirmed, sales/cancelled]
  - kind: Rule
    id: sales/cancel-before-shipped
    owner: orders-manager
    area: orders
    purpose: Stornierung nur vor Versand zulassen.
    module: sales-domain
    namespace: sales
    uses: [sales/order, sales/confirmed, sales/shipped, sales/cancelled, sales/cancellation]
    condition: Nur bestätigte und noch nicht versandte Orders dürfen storniert werden.
    outcome: Eine bereits stornierte Order bleibt bei Wiederholung unverändert; versandte Orders werden abgelehnt.
  - kind: UseCase
    id: sales/create-order
    owner: commerce-manager
    area: commerce
    purpose: Einen Kaufauftrag mit ausreichendem Bestand annehmen.
    module: sales-domain
    namespace: sales
    actor: Kunde
    uses: [sales/order, sales/confirmed, inventory/stock, inventory/reservation]
    rules: [commerce/create-reserves-stock, inventory/no-overbooking]
    requiresRealization: [commerce/create-reserves-stock, inventory/no-overbooking]
    outcome: Bestätigte Order und aktive Reservierung oder nachvollziehbare Ablehnung.
  - kind: UseCase
    id: sales/cancel-order
    owner: commerce-manager
    area: commerce
    purpose: Einen noch nicht versandten Kaufauftrag vollständig aufheben.
    module: sales-domain
    namespace: sales
    actor: Kunde
    uses: [sales/order, sales/cancellation, inventory/reservation, inventory/release]
    rules: [sales/cancel-before-shipped, commerce/cancellation-releases-reservation]
    requiresRealization: [sales/cancel-before-shipped, commerce/cancellation-releases-reservation, inventory/release]
    outcome: Stornierte Order und freigegebener Bestand oder nachvollziehbare Ablehnung.
